{
  "expo": {
    "name": "Keltron MPP EMS",
    "slug": "keltron-mpp-ems",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.keltron.mpp.ems",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Keltron EMS to use your location at all times for automated factory geofence punch-in & punch-out even when the app is closed.",
          "locationAlwaysPermission": "Allow Keltron EMS to access your background location to automatically punch in and out when entering/exiting the factory perimeter.",
          "locationWhenInUsePermission": "Allow Keltron EMS to access your location for factory distance calculation.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0284c7",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "213f645b-b14b-48bf-9456-ac5893556050"
      }
    }
  }
}
